        240,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "try {const input=$input.first().json.body??$input.first().json;\nif(input.operation!=='finalize')throw new Error('Use finalize com o mesmo payload de finalização do 02b.');\nif(!Number.isFinite(input.threshold)||input.threshold<=0||input.threshold>1)throw new Error('Limiar Jev inválido.');\nif(typeof input.text!=='string'||!input.text.trim()||input.text.length>120000)throw new Error('Texto completo vazio ou acima de 120.000 caracteres.');\nreturn [{json:{...input,ok:true}}];}catch(error){return [{json:{ok:false,error:{message:error.message}}}];}"
      }
    },

      "name": "Contar palavras do texto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        656
      ],
      "parameters": {
        "jsCode": "return $input.all().map((item, index) => {\n  if (typeof item.json.text !== 'string') throw new Error('O campo text precisa ser um texto para contar as palavras.');\n  return { ...item, json: { ...item.json, total_palavras: (item.json.text.match(/\\S+/g) ?? []).length }, pairedItem: { item: index } };\n});"
      },
      "notes": "Conta palavras de text separadas por espaços, tabs ou quebras de linha. Preserva text e os demais campos; sobrescreve total_palavras com a contagem calculada."
    },
